# Copy this file to .env and fill in real values. The app validates these at
# startup via src/lib/env.server.ts; docker compose reads the POSTGRES_* values.
POSTGRES_USER=teach
POSTGRES_PASSWORD=teach
POSTGRES_DB=teach
POSTGRES_PORT=5432
DATABASE_URL=postgres://teach:teach@localhost:5432/teach
AI_API_KEY=replace-me
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=replace-me
# Structured-output mode for the AI Teacher Engine: json_schema (default, carries
# the strict schema) or json_object (for providers that reject json_schema).
AI_RESPONSE_FORMAT=json_schema
